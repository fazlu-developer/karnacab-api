NODE_ENV=development
APP_NAME=KarnaCab API
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=api/v1
API_VERSION=1

# MySQL (XAMPP) — one database for API + Laravel prefixes
DATABASE_URL="mysql://root:@localhost:3306/karnacab_platform"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=karnacab_platform
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me

# Instant dummy-driver assign. Leave false so ride requests stay open for the driver app.
DEMO_AUTO_ASSIGN=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS — clients that will call this API
CORS_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8002,http://127.0.0.1:8000,http://127.0.0.1:8001,http://127.0.0.1:8002

# Logging
LOG_LEVEL=info

# Firebase Cloud Messaging (Karnacab)
FIREBASE_PROJECT_ID=karnacab-bf930
FIREBASE_PROJECT_NUMBER=924689551761
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Driver onboarding uploads (Cloudinary). Leave empty to store files on disk.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
KYC_MAX_BYTES=8388608
