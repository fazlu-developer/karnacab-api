generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  DRIVER
  FLEET_OWNER
  DISTRICT_HEAD
  STATE_HEAD
  FRANCHISE
  CORPORATE
  ADVERTISER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserGender {
  MALE
  FEMALE
  OTHER
}

enum PlaceKind {
  RECENT
  SAVED
}

enum VehicleCategory {
  BIKE
  AUTO
  E_RICKSHAW
  MINI
  SEDAN
  SUV
  TRAVELLER
}

enum RideProduct {
  LOCAL_CAB
  ONE_WAY
  ROUND_WAY
  RENTAL
  SCHEDULE
  OUTSTATION
  AIRPORT
  RAILWAY
  MULTI_STOP
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  DRIVER_SEARCHING
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
  REQUESTED
  QUOTED
  ASSIGNED
  ONGOING
}

enum WalletOwnerType {
  CUSTOMER
  DRIVER
  FLEET_OWNER
  DISTRICT_HEAD
  FRANCHISE
  CORPORATE
  PLATFORM
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LeadType {
  RIDE
  PARCEL
  BIHAR_PARCEL
  TRAVEL
  BULK
  CORPORATE
  FRANCHISE
  FLEET
  ADVERTISE
  SUPPORT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum CatalogGroup {
  RIDE
  PARCEL
}

enum FranchiseStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum FranchiseKind {
  DISTRICT_HEAD
  EXCLUSIVE_FRANCHISE
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model CatalogService {
  id        Int          @id @default(autoincrement())
  slug      String       @unique @db.VarChar(80)
  title     String       @db.VarChar(80)
  subtitle  String?      @db.VarChar(160)
  group     CatalogGroup @map("service_group")
  iconKey   String       @map("icon_key") @db.VarChar(40)
  badge     String?      @db.VarChar(24)
  sortOrder Int          @default(0) @map("sort_order")
  featured  Boolean      @default(false)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([group, active, sortOrder])
  @@map("catalog_services")
}

/// Public website copy. Admin PATCH via /cms/admin. Never put fare numbers here.
model CmsPage {
  id             BigInt    @id @default(autoincrement())
  slug           String    @unique @db.VarChar(80)
  title          String    @db.VarChar(160)
  eyebrow        String?   @db.VarChar(80)
  seoTitle       String?   @map("seo_title") @db.VarChar(180)
  seoDescription String?   @map("seo_description") @db.VarChar(320)
  lede           String    @db.Text
  body           Json?
  template       String    @db.VarChar(40)
  leadType       LeadType? @map("lead_type")
  registerKind   String?   @map("register_kind") @db.VarChar(32)
  productKey     String?   @map("product_key") @db.VarChar(40)
  navGroup       String    @map("nav_group") @db.VarChar(32)
  navLabel       String    @map("nav_label") @db.VarChar(80)
  sortOrder      Int       @default(0) @map("sort_order")
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([navGroup, published, sortOrder])
  @@map("cms_pages")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model User {
  id                  BigInt      @id @default(autoincrement())
  role                UserRole
  status              UserStatus  @default(ACTIVE)
  name                String      @db.VarChar(120)
  email               String      @unique @db.VarChar(180)
  phone               String?     @unique @db.VarChar(20)
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  dateOfBirth         DateTime?   @map("date_of_birth") @db.Date
  gender              UserGender?
  lastLat             Decimal?    @map("last_lat") @db.Decimal(10, 7)
  lastLng             Decimal?    @map("last_lng") @db.Decimal(10, 7)
  lastAddress         String?     @map("last_address") @db.VarChar(255)
  locationUpdatedAt   DateTime?   @map("location_updated_at")
  profileCompletedAt  DateTime?   @map("profile_completed_at")
  stateId             Int?        @map("state_id")
  districtId          Int?        @map("district_id")
  emergencyName       String?     @map("emergency_name") @db.VarChar(120)
  emergencyPhone      String?     @map("emergency_phone") @db.VarChar(20)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  state     State?     @relation(fields: [stateId], references: [id])
  district  District?  @relation(fields: [districtId], references: [id])
  driver    Driver?
  fleet     FleetOwner?
  wallets   Wallet[]
  payments  Payment[]
  invoices  Invoice[]
  adCampaigns AdCampaign[]
  bookings  Booking[]  @relation("CustomerBookings")
  parcels   ParcelShipment[] @relation("CustomerParcels")
  travelBookings TravelBooking[] @relation("CustomerTravelBookings")
  bulkBookings   BulkBooking[]   @relation("CustomerBulkBookings")
  corporateAccount CorporateAccount?
  corporateEmployment CorporateEmployee[]
  leads     Lead[]
  safetyIncidents SafetyIncident[]
  places    UserPlace[]
  familyMembers FamilyMember[]
  emergencyContacts EmergencyContact[]
  notifications UserNotification[]
  notificationDeliveries NotificationDelivery[]
  pushDevices PushDevice[]
  supportTickets SupportTicket[]
  supportAssigned SupportTicket[] @relation("SupportAgent")
  supportMessages SupportMessage[]
  couponRedemptions CouponRedemption[]
  loyaltyAccount LoyaltyAccount?
  loyaltyLedger LoyaltyLedger[]
  ownedFranchises Franchise[] @relation("FranchiseOwner")
  childFranchises Franchise[] @relation("FranchiseParent")

  @@index([role, status])
  @@index([districtId, role])
  @@map("users")
}

model UserPlace {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  kind      PlaceKind @default(RECENT)
  title     String    @db.VarChar(120)
  subtitle  String?   @db.VarChar(180)
  address   String    @db.VarChar(255)
  lat       Decimal   @db.Decimal(10, 7)
  lng       Decimal   @db.Decimal(10, 7)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("user_places")
}

model EmergencyContact {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(20)
  relation  String?  @db.VarChar(40)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

model FamilyMember {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @db.VarChar(120)
  phone     String   @db.VarChar(20)
  relation  String?  @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@map("family_members")
}

model Coupon {
  id               BigInt    @id @default(autoincrement())
  code             String    @unique @db.VarChar(32)
  title            String    @db.VarChar(160)
  subtitle         String?   @db.VarChar(255)
  kind             String    @default("percent") @db.VarChar(16)
  percent          Int       @default(0)
  amountPaise      Int       @default(0) @map("amount_paise")
  maxDiscountPaise Int       @default(0) @map("max_discount_paise")
  minFarePaise     Int       @default(0) @map("min_fare_paise")
  product          String?   @db.VarChar(32)
  stateId          Int?      @map("state_id")
  districtId       Int?      @map("district_id")
  audience         String    @default("all") @db.VarChar(24)
  usageLimit       Int       @default(0) @map("usage_limit")
  userLimit        Int       @default(0) @map("user_limit")
  startsOn         DateTime  @map("starts_on")
  endsOn           DateTime  @map("ends_on")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  state       State?             @relation(fields: [stateId], references: [id])
  district    District?          @relation(fields: [districtId], references: [id])
  redemptions CouponRedemption[]
  bookings    Booking[]

  @@index([active, startsOn, endsOn])
  @@index([stateId, districtId, active])
  @@map("coupons")
}

model CouponRedemption {
  id            BigInt   @id @default(autoincrement())
  couponId      BigInt   @map("coupon_id")
  userId        BigInt   @map("user_id")
  bookingId     BigInt?  @unique @map("booking_id")
  discountPaise Int      @default(0) @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at")

  coupon  Coupon   @relation(fields: [couponId], references: [id])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([userId, createdAt])
  @@map("coupon_redemptions")
}

model LoyaltyAccount {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

model LoyaltyLedger {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  bookingId BigInt?  @map("booking_id")
  kind      String   @db.VarChar(16)
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId, kind])
  @@map("loyalty_ledger")
}

model UserNotification {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  title      String    @db.VarChar(160)
  body       String    @db.VarChar(500)
  kind       String    @default("info") @db.VarChar(48)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.VarChar(40)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind, entityId])
  @@map("user_notifications")
}

model NotificationDelivery {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt?  @map("user_id")
  event        String   @db.VarChar(48)
  channel      String   @db.VarChar(16)
  title        String   @db.VarChar(160)
  body         String   @db.VarChar(500)
  status       String   @default("sent") @db.VarChar(24)
  providerNote String?  @map("provider_note") @db.VarChar(160)
  entityType   String?  @map("entity_type") @db.VarChar(40)
  entityId     String?  @map("entity_id") @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([channel, createdAt])
  @@map("notification_deliveries")
}

model PushDevice {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String   @unique @db.VarChar(512)
  platform  String   @default("android") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model SupportFaq {
  id        BigInt   @id @default(autoincrement())
  audience  String   @db.VarChar(24)
  question  String   @db.VarChar(255)
  answer    String   @db.VarChar(2000)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([audience, active, sortOrder])
  @@map("support_faqs")
}

model SupportTicket {
  id               BigInt    @id @default(autoincrement())
  publicRef        String    @unique @map("public_ref") @db.VarChar(24)
  userId           BigInt    @map("user_id")
  kind             String    @db.VarChar(32)
  status           String    @default("open") @db.VarChar(24)
  subject          String    @db.VarChar(160)
  bookingId        BigInt?   @map("booking_id")
  safetyIncidentId BigInt?   @map("safety_incident_id")
  districtId       Int?      @map("district_id")
  category         String    @default("other") @db.VarChar(32)
  description      String    @default("") @db.VarChar(2000)
  priority         String    @default("medium") @db.VarChar(16)
  assignedAgentId  BigInt?   @map("assigned_agent_id")
  resolution       String?   @db.VarChar(2000)
  resolvedAt       DateTime? @map("resolved_at")
  closedAt         DateTime? @map("closed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAgent  User?            @relation("SupportAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  safetyIncident SafetyIncident?  @relation(fields: [safetyIncidentId], references: [id], onDelete: SetNull)
  district       District?        @relation(fields: [districtId], references: [id], onDelete: SetNull)
  messages       SupportMessage[]
  attachments    SupportAttachment[]
  events         SupportTicketEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([kind, status])
  @@index([districtId, status])
  @@index([assignedAgentId, status])
  @@map("support_tickets")
}

model SupportTicketEvent {
  id          BigInt   @id @default(autoincrement())
  ticketId    BigInt   @map("ticket_id")
  actorUserId BigInt?  @map("actor_user_id")
  action      String   @db.VarChar(32)
  fromStatus  String?  @map("from_status") @db.VarChar(24)
  toStatus    String?  @map("to_status") @db.VarChar(24)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_events")
}

model SupportMessage {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @map("ticket_id")
  authorId   BigInt   @map("author_id")
  fromStaff  Boolean  @default(false) @map("from_staff")
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id           BigInt   @id @default(autoincrement())
  ticketId     BigInt   @map("ticket_id")
  messageId    BigInt?  @map("message_id")
  storageKey   String   @map("storage_key") @db.VarChar(255)
  mime         String   @db.VarChar(80)
  originalName String   @map("original_name") @db.VarChar(160)
  bytes        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  ticket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_attachments")
}

model State {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(8)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  districts  District[]
  users      User[]
  franchises Franchise[]
  adCampaigns AdCampaign[]
  coupons    Coupon[]

  @@map("states")
}

model District {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  code      String   @unique @db.VarChar(16)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  state      State       @relation(fields: [stateId], references: [id])
  users      User[]
  franchises Franchise[]
  fareRules  FareRule[]
  vehicles   Vehicle[]
  bookings   Booking[]
  packages   TravelPackage[]
  adCampaigns AdCampaign[]
  safetyIncidents SafetyIncident[]
  coupons    Coupon[]
  supportTickets SupportTicket[]

  @@index([stateId, name])
  @@map("districts")
}

/// Exclusive district seat: `active_district_key` is unique and set only while ACTIVE.
model Franchise {
  id                  BigInt          @id @default(autoincrement())
  districtId          Int             @map("district_id")
  stateId             Int             @map("state_id")
  ownerUserId         BigInt          @map("owner_user_id")
  parentUserId        BigInt?         @map("parent_user_id")
  kind                FranchiseKind   @default(EXCLUSIVE_FRANCHISE)
  status              FranchiseStatus @default(APPLIED)
  /// Set to districtId string only while ACTIVE; null otherwise. One district = one active head/franchise.
  activeDistrictKey   String?         @unique @map("active_district_key") @db.VarChar(16)
  tradeName           String          @default("") @map("trade_name") @db.VarChar(160)
  gstin               String?         @db.VarChar(20)
  pan                 String?         @db.VarChar(20)
  contactPhone        String?         @map("contact_phone") @db.VarChar(20)
  kycStatus           String          @default("pending") @map("kyc_status") @db.VarChar(32)
  agreementStatus     String          @default("unsigned") @map("agreement_status") @db.VarChar(32)
  feeAmountPaise      BigInt          @default(0) @map("fee_amount_paise")
  feePaidAt           DateTime?       @map("fee_paid_at")
  commissionPercent   Decimal         @default(0) @map("commission_percent") @db.Decimal(5, 2)
  startsOn            DateTime?       @map("starts_on")
  endsOn              DateTime?       @map("ends_on")
  terminatedAt        DateTime?       @map("terminated_at")
  terminationReason   String?         @map("termination_reason") @db.VarChar(500)
  notes               String?         @db.VarChar(500)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  district   District               @relation(fields: [districtId], references: [id])
  state      State                  @relation(fields: [stateId], references: [id])
  owner      User                   @relation("FranchiseOwner", fields: [ownerUserId], references: [id])
  parent     User?                  @relation("FranchiseParent", fields: [parentUserId], references: [id])
  documents  FranchiseDocument[]
  agreements FranchiseAgreement[]
  fees       FranchiseFee[]
  renewals   FranchiseRenewal[]
  events     FranchiseEvent[]

  @@index([districtId, status])
  @@index([stateId, status])
  @@index([ownerUserId, status])
  @@index([status])
  @@map("franchises")
}

model FranchiseDocument {
  id              BigInt    @id @default(autoincrement())
  franchiseId     BigInt    @map("franchise_id")
  type            String    @db.VarChar(32)
  status          String    @default("pending") @db.VarChar(32)
  storageKey      String    @unique @map("storage_key") @db.VarChar(255)
  originalName    String?   @map("original_name") @db.VarChar(180)
  mime            String    @db.VarChar(80)
  sizeBytes       Int       @map("size_bytes")
  checksumSha256  String    @map("checksum_sha256") @db.VarChar(64)
  expiresAt       DateTime? @map("expires_at") @db.Date
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, type])
  @@index([status])
  @@map("franchise_documents")
}

model FranchiseAgreement {
  id          BigInt    @id @default(autoincrement())
  franchiseId BigInt    @map("franchise_id")
  version     String    @db.VarChar(32)
  title       String    @db.VarChar(160)
  signedAt    DateTime? @map("signed_at")
  expiresAt   DateTime? @map("expires_at")
  status      String    @default("draft") @db.VarChar(32)
  createdAt   DateTime  @default(now()) @map("created_at")

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId, createdAt])
  @@map("franchise_agreements")
}

model FranchiseFee {
  id          BigInt    @id @default(autoincrement())
  franchiseId BigInt    @map("franchise_id")
  kind        String    @db.VarChar(24)
  amountPaise BigInt    @map("amount_paise")
  status      String    @default("due") @db.VarChar(24)
  dueOn       DateTime? @map("due_on")
  paidAt      DateTime? @map("paid_at")
  note        String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId, status])
  @@map("franchise_fees")
}

model FranchiseRenewal {
  id          BigInt    @id @default(autoincrement())
  franchiseId BigInt    @map("franchise_id")
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  status      String    @default("pending") @db.VarChar(24)
  createdAt   DateTime  @default(now()) @map("created_at")

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId, periodEnd])
  @@map("franchise_renewals")
}

model FranchiseEvent {
  id          BigInt   @id @default(autoincrement())
  franchiseId BigInt   @map("franchise_id")
  actorUserId BigInt   @map("actor_user_id")
  action      String   @db.VarChar(48)
  fromStatus  String?  @map("from_status") @db.VarChar(32)
  toStatus    String?  @map("to_status") @db.VarChar(32)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId, createdAt])
  @@map("franchise_events")
}

model FleetOwner {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  tradeName String   @map("trade_name") @db.VarChar(160)
  gstin     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  drivers  Driver[]
  vehicles Vehicle[]

  @@map("fleet_owners")
}

model Driver {
  id                     BigInt    @id @default(autoincrement())
  userId                 BigInt    @unique @map("user_id")
  fleetOwnerId           BigInt?   @map("fleet_owner_id")
  licenseNo              String    @map("license_no") @db.VarChar(40)
  online                 Boolean   @default(false)
  dutyStatus             String    @default("offline") @map("duty_status") @db.VarChar(32)
  parcelEnabled          Boolean   @default(false) @map("parcel_enabled")
  ratingAvg              Decimal   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  kycStatus              String    @default("pending") @map("kyc_status") @db.VarChar(32)
  city                   String?   @db.VarChar(80)
  termsAcceptedAt        DateTime? @map("terms_accepted_at")
  applicationSubmittedAt DateTime? @map("application_submitted_at")
  kycRejectedReason      String?   @map("kyc_rejected_reason") @db.VarChar(500)
  bankAccountHolder      String?   @map("bank_account_holder") @db.VarChar(120)
  bankIfsc               String?   @map("bank_ifsc") @db.VarChar(20)
  bankAccountLast4       String?   @map("bank_account_last4") @db.VarChar(4)
  bankAccountHash        String?   @map("bank_account_hash") @db.VarChar(64)
  upiId                  String?   @map("upi_id") @db.VarChar(80)
  idType                 String?   @map("id_type") @db.VarChar(32)
  idLast4                String?   @map("id_last4") @db.VarChar(8)
  idHash                 String?   @map("id_hash") @db.VarChar(64)
  emergencyName          String?   @map("emergency_name") @db.VarChar(120)
  emergencyPhone         String?   @map("emergency_phone") @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id])
  fleetOwner FleetOwner?      @relation(fields: [fleetOwnerId], references: [id])
  vehicles   Vehicle[]
  bookings   Booking[]
  parcels    ParcelShipment[]
  documents  DriverDocument[]
  offerDeclines DriverOfferDecline[]
  incentiveAwards DriverIncentiveAward[]
  safetyIncidents SafetyIncident[]

  @@index([online, parcelEnabled])
  @@index([dutyStatus])
  @@index([kycStatus])
  @@map("drivers")
}

model DriverIncentiveAward {
  id           BigInt   @id @default(autoincrement())
  driverId     BigInt   @map("driver_id")
  incentiveId  String   @map("incentive_id") @db.VarChar(64)
  periodKey    String   @map("period_key") @db.VarChar(24)
  amountPaise  BigInt   @map("amount_paise")
  ledgerId     BigInt?  @map("ledger_id")
  createdAt    DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, incentiveId, periodKey])
  @@index([driverId, createdAt])
  @@map("driver_incentive_awards")
}

model DriverOfferDecline {
  id        BigInt   @id @default(autoincrement())
  driverId  BigInt   @map("driver_id")
  kind      String   @db.VarChar(16)
  targetId  BigInt   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, kind, targetId])
  @@index([driverId, kind])
  @@map("driver_offer_declines")
}

model DriverDocument {
  id               BigInt    @id @default(autoincrement())
  driverId         BigInt    @map("driver_id")
  type             String    @db.VarChar(32)
  status           String    @default("pending") @db.VarChar(32)
  storageKey       String    @unique @map("storage_key") @db.VarChar(255)
  originalName     String?   @map("original_name") @db.VarChar(180)
  mime             String    @db.VarChar(80)
  sizeBytes        Int       @map("size_bytes")
  checksumSha256   String    @map("checksum_sha256") @db.VarChar(64)
  expiresAt        DateTime? @map("expires_at") @db.Date
  rejectionReason  String?   @map("rejection_reason") @db.VarChar(500)
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId BigInt?   @map("reviewed_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, type])
  @@index([status])
  @@map("driver_documents")
}

model Vehicle {
  id             BigInt          @id @default(autoincrement())
  districtId     Int             @map("district_id")
  fleetOwnerId   BigInt?         @map("fleet_owner_id")
  driverId       BigInt?         @map("driver_id")
  category       VehicleCategory
  registrationNo String          @unique @map("registration_no") @db.VarChar(20)
  status         String          @default("offline") @db.VarChar(20)
  lastLat        Decimal?        @map("last_lat") @db.Decimal(10, 7)
  lastLng        Decimal?        @map("last_lng") @db.Decimal(10, 7)
  lastFixAt      DateTime?       @map("last_fix_at")
  brand          String?         @db.VarChar(80)
  model          String?         @db.VarChar(80)
  year           Int?
  color          String?         @db.VarChar(40)
  fuel           String?         @db.VarChar(20)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  district   District    @relation(fields: [districtId], references: [id])
  fleetOwner FleetOwner? @relation(fields: [fleetOwnerId], references: [id])
  driver     Driver?     @relation(fields: [driverId], references: [id])
  bookings   Booking[]
  documents  VehicleDocument[]

  @@index([districtId, status])
  @@index([category, status])
  @@map("vehicles")
}

model VehicleDocument {
  id               BigInt    @id @default(autoincrement())
  vehicleId        BigInt    @map("vehicle_id")
  type             String    @db.VarChar(32)
  status           String    @default("pending") @db.VarChar(32)
  storageKey       String    @unique @map("storage_key") @db.VarChar(255)
  originalName     String?   @map("original_name") @db.VarChar(180)
  mime             String    @db.VarChar(80)
  sizeBytes        Int       @map("size_bytes")
  checksumSha256   String    @map("checksum_sha256") @db.VarChar(64)
  expiresAt        DateTime? @map("expires_at") @db.Date
  rejectionReason  String?   @map("rejection_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, type])
  @@index([status])
  @@map("vehicle_documents")
}

model FareRule {
  id              Int          @id @default(autoincrement())
  districtId      Int?         @map("district_id")
  product         RideProduct
  category        VehicleCategory
  minKm           Decimal      @map("min_km") @db.Decimal(8, 2)
  includedKm      Decimal      @map("included_km") @db.Decimal(8, 2)
  perKmPaise      Int          @map("per_km_paise")
  extraKmPaise    Int          @map("extra_km_paise")
  waitingPaise    Int          @map("waiting_paise_per_min")
  nightPercent    Int          @map("night_percent")
  gstPercent      Int          @map("gst_percent")
  cancelPaise     Int          @map("cancel_paise")
  discountPaise   Int          @default(0) @map("discount_paise")
  discountPercent Int          @default(0) @map("discount_percent")
  driverAllowPaise Int         @default(0) @map("driver_allow_paise")
  rentalHours     Int?         @map("rental_hours")
  extraHourPaise  Int          @default(15000) @map("extra_hour_paise")
  nightStayPaise  Int          @default(0) @map("night_stay_paise")
  stopPaise       Int          @default(0) @map("stop_paise")
  applyToll       Boolean      @default(true) @map("apply_toll")
  applyParking    Boolean      @default(true) @map("apply_parking")
  applyGstToBase  Boolean      @default(true) @map("apply_gst_to_base")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id])

  @@index([product, category, active])
  @@index([districtId, product, category])
  @@map("fare_rules")
}

model CommissionRule {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(80)
  percent        Decimal  @db.Decimal(5, 2)
  onBaseFare     Boolean  @default(true) @map("on_base_fare")
  onGst          Boolean  @default(false) @map("on_gst")
  onToll         Boolean  @default(false) @map("on_toll")
  onParking      Boolean  @default(false) @map("on_parking")
  onWaiting      Boolean  @default(false) @map("on_waiting")
  onDiscount     Boolean  @default(false) @map("on_discount")
  onOther        Boolean  @default(false) @map("on_other")
  onComplete     Boolean  @default(false) @map("on_complete")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("commission_rules")
}

model Booking {
  id             BigInt         @id @default(autoincrement())
  publicRef      String         @unique @map("public_ref") @db.VarChar(24)
  customerId     BigInt         @map("customer_id")
  districtId     Int?           @map("district_id")
  product        RideProduct
  category       VehicleCategory
  status         BookingStatus  @default(REQUESTED)
  pickupText     String         @map("pickup_text") @db.VarChar(255)
  dropText       String         @map("drop_text") @db.VarChar(255)
  pickupLat      Decimal?       @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng      Decimal?       @map("pickup_lng") @db.Decimal(10, 7)
  dropLat        Decimal?       @map("drop_lat") @db.Decimal(10, 7)
  dropLng        Decimal?       @map("drop_lng") @db.Decimal(10, 7)
  polyline       String?        @db.Text
  scheduledAt    DateTime?      @map("scheduled_at")
  returnAt       DateTime?      @map("return_at")
  distanceKm     Decimal?       @map("distance_km") @db.Decimal(10, 2)
  quotePaise     BigInt?        @map("quote_paise")
  quoteSnapshot  Json?          @map("quote_snapshot")
  flightNumber   String?        @map("flight_number") @db.VarChar(32)
  trainNumber    String?        @map("train_number") @db.VarChar(32)
  terminal       String?        @db.VarChar(80)
  driverId       BigInt?        @map("driver_id")
  vehicleId      BigInt?        @map("vehicle_id")
  startOtp       String?        @map("start_otp") @db.VarChar(8)
  endOtp         String?        @map("end_otp") @db.VarChar(8)
  tripStartedAt  DateTime?      @map("trip_started_at")
  tripEndedAt    DateTime?      @map("trip_ended_at")
  shareToken     String?        @unique @map("share_token") @db.VarChar(64)
  shareExpiresAt DateTime?      @map("share_expires_at")
  passengerName  String?        @map("passenger_name") @db.VarChar(120)
  passengerPhone String?        @map("passenger_phone") @db.VarChar(20)
  instructions   String?        @db.VarChar(500)
  bookedForOther Boolean        @default(false) @map("booked_for_other")
  familyMemberId BigInt?        @map("family_member_id")
  couponId       BigInt?        @map("coupon_id")
  couponDiscountPaise Int       @default(0) @map("coupon_discount_paise")
  corporateAccountId BigInt?    @map("corporate_account_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  customer User      @relation("CustomerBookings", fields: [customerId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  stops    BookingStop[]
  payments Payment[]
  invoices Invoice[]
  ratings  BookingRating[]
  ledgerEntries WalletLedger[]
  safetyIncidents SafetyIncident[]
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  supportTickets SupportTicket[]
  couponRedemption CouponRedemption?

  @@index([customerId, createdAt])
  @@index([districtId, status, createdAt])
  @@index([status, createdAt])
  @@index([corporateAccountId])
  @@index([bookedForOther])
  @@map("bookings")
}

model BookingRating {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @map("booking_id")
  fromRole  String   @map("from_role") @db.VarChar(16)
  stars     Int
  comment   String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, fromRole])
  @@index([bookingId])
  @@map("booking_ratings")
}

model SafetyIncident {
  id             BigInt   @id @default(autoincrement())
  publicRef      String   @unique @map("public_ref") @db.VarChar(24)
  type           String   @db.VarChar(32)
  status         String   @default("open") @db.VarChar(24)
  description    String   @default("") @db.VarChar(1000)
  bookingId      BigInt?  @map("booking_id")
  reporterUserId BigInt   @map("reporter_user_id")
  driverId       BigInt?  @map("driver_id")
  districtId     Int?     @map("district_id")
  lat            Decimal? @db.Decimal(10, 7)
  lng            Decimal? @db.Decimal(10, 7)
  locationText   String?  @map("location_text") @db.VarChar(255)
  adminNote      String?  @map("admin_note") @db.VarChar(1000)
  kind           String?  @db.VarChar(24)
  actorRole      String?  @map("actor_role") @db.VarChar(24)
  emergencyName  String?  @map("emergency_name") @db.VarChar(120)
  emergencyPhone String?  @map("emergency_phone") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  booking  Booking? @relation(fields: [bookingId], references: [id])
  reporter User     @relation(fields: [reporterUserId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  supportTickets SupportTicket[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([bookingId])
  @@index([driverId])
  @@index([districtId, status])
  @@map("safety_incidents")
}

model BookingStop {
  id        BigInt  @id @default(autoincrement())
  bookingId BigInt  @map("booking_id")
  seq       Int
  label     String  @db.VarChar(255)
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, seq])
  @@map("booking_stops")
}

model ParcelShipment {
  id                   BigInt           @id @default(autoincrement())
  publicRef            String           @unique @map("public_ref") @db.VarChar(24)
  customerId           BigInt           @map("customer_id")
  biharLane            Boolean          @default(false) @map("bihar_lane")
  parcelType           String           @map("parcel_type") @db.VarChar(80)
  description          String?          @db.VarChar(255)
  weightKg             Decimal          @map("weight_kg") @db.Decimal(8, 2)
  lengthCm             Decimal?         @map("length_cm") @db.Decimal(8, 2)
  widthCm              Decimal?         @map("width_cm") @db.Decimal(8, 2)
  heightCm             Decimal?         @map("height_cm") @db.Decimal(8, 2)
  quantity             Int              @default(1)
  category             VehicleCategory  @default(BIKE)
  pickupText           String           @map("pickup_text") @db.VarChar(255)
  dropText             String           @map("drop_text") @db.VarChar(255)
  pickupLat            Decimal?         @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng            Decimal?         @map("pickup_lng") @db.Decimal(10, 7)
  dropLat              Decimal?         @map("drop_lat") @db.Decimal(10, 7)
  dropLng              Decimal?         @map("drop_lng") @db.Decimal(10, 7)
  distanceKm           Decimal?         @map("distance_km") @db.Decimal(10, 2)
  contactName          String?          @map("contact_name") @db.VarChar(120)
  contactPhone         String?          @map("contact_phone") @db.VarChar(20)
  instructions         String?          @db.VarChar(255)
  complianceConfirmed  Boolean          @default(false) @map("compliance_confirmed")
  quotePaise           BigInt?          @map("quote_paise")
  quoteSnapshot        Json?            @map("quote_snapshot")
  paymentStatus        String           @default("unpaid") @map("payment_status") @db.VarChar(20)
  paymentMethod        String?          @map("payment_method") @db.VarChar(20)
  driverId             BigInt?          @map("driver_id")
  vehicleId            BigInt?          @map("vehicle_id")
  pickupOtp            String?          @map("pickup_otp") @db.VarChar(8)
  deliveryPin          String?          @map("delivery_pin") @db.VarChar(8)
  status               String           @default("created") @db.VarChar(24)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  customer User     @relation("CustomerParcels", fields: [customerId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([driverId, status])
  @@map("parcel_shipments")
}

model ParcelFareRule {
  id              Int             @id @default(autoincrement())
  lane            String          @db.VarChar(16)
  category        VehicleCategory
  minKm           Decimal         @map("min_km") @db.Decimal(8, 2)
  includedKm      Decimal         @map("included_km") @db.Decimal(8, 2)
  perKmPaise      Int             @map("per_km_paise")
  extraKmPaise    Int             @map("extra_km_paise")
  perKgPaise      Int             @map("per_kg_paise")
  minChargePaise  Int             @map("min_charge_paise")
  gstPercent      Int             @map("gst_percent")
  volumetricDivisor Int           @default(5000) @map("volumetric_divisor")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([lane, category])
  @@index([lane, category, active])
  @@map("parcel_fare_rules")
}

model TravelPackage {
  id              Int           @id @default(autoincrement())
  districtId      Int?          @map("district_id")
  category        String        @default("SIGHTSEEING") @db.VarChar(40)
  title           String        @db.VarChar(160)
  destination     String        @db.VarChar(160)
  places          String        @db.Text
  durationHours   Int           @map("duration_hours")
  durationLabel   String?       @map("duration_label") @db.VarChar(80)
  kmIncluded      Int           @map("km_included")
  vehicleLabel    String        @map("vehicle_label") @db.VarChar(80)
  driverLabel     String        @default("Dedicated driver") @map("driver_label") @db.VarChar(80)
  pricePaise      Int           @map("price_paise")
  inclusions      String        @db.Text
  exclusions      String        @db.Text
  itinerary       Json?
  gallery         Json?
  availableDates  Json?         @map("available_dates")
  status          PackageStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
