  corporateAccount CorporateAccount?  @relation(fields: [corporateAccountId], references: [id])
  payments         Payment[]
  invoices         Invoice[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([corporateAccountId])
  @@map("bulk_bookings")
}

model CorporateAccount {
  id            BigInt   @id @default(autoincrement())
  ownerUserId   BigInt   @unique @map("owner_user_id")
  companyName   String   @map("company_name") @db.VarChar(160)
  gstin         String?  @db.VarChar(15)
  contactName   String   @map("contact_name") @db.VarChar(120)
  contactPhone  String   @map("contact_phone") @db.VarChar(20)
  contactEmail  String?  @map("contact_email") @db.VarChar(180)
  districtId    Int?     @map("district_id")
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner      User                 @relation(fields: [ownerUserId], references: [id])
  employees  CorporateEmployee[]
  invoices   CorporateInvoice[]
  bulkJobs   BulkBooking[]
  bookings   Booking[]

  @@index([status, createdAt])
  @@map("corporate_accounts")
}

model CorporateEmployee {
  id         BigInt   @id @default(autoincrement())
  accountId  BigInt   @map("account_id")
  userId     BigInt?  @map("user_id")
  name       String   @db.VarChar(120)
  phone      String   @db.VarChar(20)
  email      String?  @db.VarChar(180)
  department String?  @db.VarChar(80)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  account CorporateAccount @relation(fields: [accountId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@unique([accountId, phone])
  @@index([accountId, active])
  @@map("corporate_employees")
}

model CorporateInvoice {
  id            BigInt   @id @default(autoincrement())
  publicRef     String   @unique @map("public_ref") @db.VarChar(24)
  accountId     BigInt   @map("account_id")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  subtotalPaise BigInt   @map("subtotal_paise")
  gstPaise      BigInt   @map("gst_paise")
  totalPaise    BigInt   @map("total_paise")
  gstin         String?  @db.VarChar(15)
  status        String   @default("issued") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account  CorporateAccount @relation(fields: [accountId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([accountId, periodStart])
  @@map("corporate_invoices")
}

model Wallet {
  id          BigInt          @id @default(autoincrement())
  ownerType   WalletOwnerType @map("owner_type")
  ownerUserId BigInt          @map("owner_user_id")
  balancePaise BigInt         @default(0) @map("balance_paise")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  owner        User               @relation(fields: [ownerUserId], references: [id])
  entries      WalletLedger[]
  withdrawals  WalletWithdrawal[]

  @@unique([ownerType, ownerUserId])
  @@map("wallets")
}

model WalletLedger {
  id              BigInt          @id @default(autoincrement())
  publicRef       String          @unique @map("public_ref") @db.VarChar(24)
  walletId        BigInt          @map("wallet_id")
  bookingId       BigInt?         @map("booking_id")
  ownerUserId     BigInt?         @map("owner_user_id")
  account         WalletOwnerType
  direction       LedgerDirection
  amountPaise     BigInt          @map("amount_paise")
  commissionPaise BigInt          @default(0) @map("commission_paise")
  grossPaise      BigInt          @default(0) @map("gross_paise")
  balanceBefore   BigInt          @map("balance_before_paise")
  balanceAfter    BigInt          @map("balance_after_paise")
  paymentRef      String?         @map("payment_ref") @db.VarChar(64)
  kind            String          @default("trip") @db.VarChar(24)
  status          String          @default("posted") @db.VarChar(20)
  note            String?         @db.VarChar(255)
  createdAt       DateTime        @default(now()) @map("created_at")

  wallet     Wallet            @relation(fields: [walletId], references: [id])
  booking    Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  withdrawal WalletWithdrawal?

  @@unique([bookingId, walletId, kind, direction], map: "wallet_ledger_booking_post_key")
  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([kind, createdAt])
  @@index([account, createdAt])
  @@map("wallet_ledger")
}

model WalletWithdrawal {
  id           BigInt   @id @default(autoincrement())
  publicRef    String   @unique @map("public_ref") @db.VarChar(24)
  walletId     BigInt   @map("wallet_id")
  ledgerId     BigInt   @unique @map("ledger_id")
  amountPaise  BigInt   @map("amount_paise")
  status       String   @db.VarChar(20)
  note         String?  @db.VarChar(255)
  reviewedById BigInt?  @map("reviewed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  wallet Wallet       @relation(fields: [walletId], references: [id])
  ledger WalletLedger @relation(fields: [ledgerId], references: [id])

  @@index([walletId, createdAt])
  @@index([status])
  @@map("wallet_withdrawals")
}

model Invoice {
  id                 BigInt   @id @default(autoincrement())
  publicRef          String   @unique @map("public_ref") @db.VarChar(24)
  kind               String   @db.VarChar(16)
  customerId         BigInt   @map("customer_id")
  bookingId          BigInt?  @map("booking_id")
  parcelId           BigInt?  @map("parcel_id")
  travelBookingId    BigInt?  @map("travel_booking_id")
  bulkBookingId      BigInt?  @map("bulk_booking_id")
  corporateInvoiceId BigInt?  @map("corporate_invoice_id")
  status             String   @default("issued") @db.VarChar(20)
  currency           String   @default("INR") @db.VarChar(8)
  subtotalPaise      BigInt   @map("subtotal_paise")
  taxPaise           BigInt   @default(0) @map("tax_paise")
  totalPaise         BigInt   @map("total_paise")
  paidPaise          BigInt   @default(0) @map("paid_paise")
  refundedPaise      BigInt   @default(0) @map("refunded_paise")
  lines              Json?
  issuedAt           DateTime @default(now()) @map("issued_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  customer         User               @relation(fields: [customerId], references: [id])
  booking          Booking?           @relation(fields: [bookingId], references: [id])
  parcel           ParcelShipment?    @relation(fields: [parcelId], references: [id])
  travelBooking    TravelBooking?     @relation(fields: [travelBookingId], references: [id])
  bulkBooking      BulkBooking?       @relation(fields: [bulkBookingId], references: [id])
  corporateInvoice CorporateInvoice?  @relation(fields: [corporateInvoiceId], references: [id])
  payments         Payment[]

  @@index([customerId, createdAt])
  @@index([kind, status])
  @@index([bookingId])
  @@index([parcelId])
  @@index([travelBookingId])
  @@index([bulkBookingId])
  @@index([corporateInvoiceId])
  @@map("invoices")
}

model Payment {
  id                   BigInt    @id @default(autoincrement())
  publicRef            String    @unique @map("public_ref") @db.VarChar(24)
  bookingId            BigInt?   @map("booking_id")
  parcelId             BigInt?   @map("parcel_id")
  travelBookingId      BigInt?   @map("travel_booking_id")
  bulkBookingId        BigInt?   @map("bulk_booking_id")
  corporateInvoiceId   BigInt?   @map("corporate_invoice_id")
  invoiceId            BigInt?   @map("invoice_id")
  customerId           BigInt?   @map("customer_id")
  parentId             BigInt?   @map("parent_id")
  method               String    @db.VarChar(20)
  kind                 String    @default("payment") @db.VarChar(24)
  intent               String    @default("capture") @db.VarChar(24)
  amountPaise          BigInt    @map("amount_paise")
  status               String    @db.VarChar(20)
  gateway              String    @default("none") @db.VarChar(32)
  gatewayOrderId       String?   @map("gateway_order_id") @db.VarChar(64)
  gatewayPaymentId     String?   @map("gateway_payment_id") @db.VarChar(64)
  failureCode          String?   @map("failure_code") @db.VarChar(40)
  failureNote          String?   @map("failure_note") @db.VarChar(255)
  verifiedAt           DateTime? @map("verified_at")
  verifiedSource       String?   @map("verified_source") @db.VarChar(24)
  attemptNo            Int       @default(1) @map("attempt_no")
  note                 String?   @db.VarChar(255)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  booking            Booking?           @relation(fields: [bookingId], references: [id])
  parcel             ParcelShipment?    @relation(fields: [parcelId], references: [id])
  travelBooking      TravelBooking?     @relation(fields: [travelBookingId], references: [id])
  bulkBooking        BulkBooking?       @relation(fields: [bulkBookingId], references: [id])
  corporateInvoice   CorporateInvoice?  @relation(fields: [corporateInvoiceId], references: [id])
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id])
  customer           User?              @relation(fields: [customerId], references: [id])
  parent             Payment?           @relation("PaymentRefunds", fields: [parentId], references: [id])
  refunds            Payment[]          @relation("PaymentRefunds")
  events             PaymentEvent[]

  @@index([bookingId, status])
  @@index([parcelId, status])
  @@index([travelBookingId, status])
  @@index([bulkBookingId, status])
  @@index([corporateInvoiceId, status])
  @@index([invoiceId, status])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id             BigInt   @id @default(autoincrement())
  paymentId      BigInt   @map("payment_id")
  source         String   @db.VarChar(24)
  eventType      String   @map("event_type") @db.VarChar(40)
  gatewayEventId String?  @unique @map("gateway_event_id") @db.VarChar(80)
  payload        Json?
  signatureValid Boolean  @default(false) @map("signature_valid")
  createdAt      DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model AdCampaign {
  id              BigInt    @id @default(autoincrement())
  advertiserUserId BigInt?  @map("advertiser_user_id")
  businessName    String    @default("") @map("business_name") @db.VarChar(160)
  businessInfo    String?   @map("business_info") @db.Text
  title           String    @db.VarChar(160)
  category        String    @default("local_businesses") @db.VarChar(32)
  campaignType    String    @default("banner") @map("campaign_type") @db.VarChar(32)
  bannerKey       String?   @map("banner_key") @db.VarChar(255)
  bannerMime      String?   @map("banner_mime") @db.VarChar(80)
  targetCity      String?   @map("target_city") @db.VarChar(80)
  stateId         Int?      @map("state_id")
  districtId      Int?      @map("district_id")
  startsOn        DateTime  @map("starts_on")
  endsOn          DateTime  @map("ends_on")
  budgetPaise     BigInt    @map("budget_paise")
  budgetUsedPaise BigInt    @default(0) @map("budget_used_paise")
  status          String    @default("pending") @db.VarChar(20)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  ctaUrl          String?   @map("cta_url") @db.VarChar(500)
  rejectedReason  String?   @map("rejected_reason") @db.VarChar(255)
  reviewedById    BigInt?   @map("reviewed_by_id")
  reviewedAt      DateTime? @map("reviewed_at")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  advertiser User?     @relation(fields: [advertiserUserId], references: [id])
  state      State?    @relation(fields: [stateId], references: [id])
  district   District? @relation(fields: [districtId], references: [id])
  events     AdEvent[]

  @@index([status, startsOn, endsOn])
  @@index([advertiserUserId, createdAt])
  @@index([districtId, status])
  @@index([stateId, status])
  @@index([category, status])
  @@map("ad_campaigns")
}

model AdEvent {
  id         BigInt   @id @default(autoincrement())
  campaignId BigInt   @map("campaign_id")
  userId     BigInt?  @map("user_id")
  kind       String   @db.VarChar(16)
  placement  String   @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")

  campaign AdCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, kind, createdAt])
  @@index([userId, campaignId, kind, createdAt])
  @@map("ad_events")
}

model Lead {
  id         BigInt     @id @default(autoincrement())
  type       LeadType
  status     LeadStatus @default(NEW)
  name       String     @db.VarChar(120)
  phone      String     @db.VarChar(20)
  email      String?    @db.VarChar(180)
  district   String?    @db.VarChar(80)
  message    String     @db.Text
  payload    String?    @db.Text
  userId     BigInt?    @map("user_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([type, status, createdAt])
  @@map("leads")
}

/// Append-only platform audit. No FKs so existing users/bookings are never coupled.
model PlatformAuditEvent {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt?  @map("actor_user_id")
  domain      String   @db.VarChar(40)
  action      String   @db.VarChar(40)
  entityType  String?  @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.VarChar(40)
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([domain, createdAt])
  @@index([actorUserId, createdAt])
  @@map("platform_audit_events")
}
