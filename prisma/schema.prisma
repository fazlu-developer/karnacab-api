  district District?       @relation(fields: [districtId], references: [id])
  bookings TravelBooking[]

  @@index([status, category])
  @@index([status, destination])
  @@map("travel_packages")
}

model TravelBooking {
  id              BigInt   @id @default(autoincrement())
  publicRef       String   @unique @map("public_ref") @db.VarChar(24)
  customerId      BigInt   @map("customer_id")
  packageId       Int      @map("package_id")
  travelDate      DateTime @map("travel_date") @db.Date
  guests          Int      @default(1)
  contactName     String   @map("contact_name") @db.VarChar(120)
  contactPhone    String   @map("contact_phone") @db.VarChar(20)
  notes           String?  @db.VarChar(255)
  quotePaise      BigInt   @map("quote_paise")
  quoteSnapshot   Json?    @map("quote_snapshot")
  paymentStatus   String   @default("unpaid") @map("payment_status") @db.VarChar(20)
  paymentMethod   String?  @map("payment_method") @db.VarChar(20)
  status          String   @default("created") @db.VarChar(24)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer User          @relation("CustomerTravelBookings", fields: [customerId], references: [id])
  package  TravelPackage @relation(fields: [packageId], references: [id])
  payments Payment[]
  invoices Invoice[]

  @@index([customerId, createdAt])
  @@index([packageId, travelDate])
  @@index([status, createdAt])
  @@map("travel_bookings")
}

model BulkRateRule {
  id             Int             @id @default(autoincrement())
  eventKey       String          @map("event_key") @db.VarChar(40)
  category       VehicleCategory
  perVehiclePaise Int            @map("per_vehicle_paise")
  gstPercent     Int             @map("gst_percent")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([eventKey, category])
  @@index([eventKey, category, active])
  @@map("bulk_rate_rules")
}

model BulkBooking {
